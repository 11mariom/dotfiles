# -*- sh -*-
##
# cd == cd + ls (only in a terminal, so tools/scripts/agents stay quiet)
cd() {
    builtin cd "$@" || return
    [[ -t 1 ]] && ls --color="auto"
    return 0
}

##
# extract
ext() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2) tar -jxvf "$1" ;;
            *.tar.gz) tar -zxvf "$1" ;;
            *.tar.xz) tar -Jxvf "$1" ;;
            *.bz2) bzip2 -d "$1" ;;
            *.gz) gunzip -d "$1" ;;
            *.tar) tar -xvf "$1" ;;
            *.tgz) tar -zxvf "$1" ;;
            *.tbz2) tar -xvzf "$1" ;;
            *.zip) unzip "$1" ;;
            *.Z) uncompress "$1" ;;
            *.7z) 7z x "$1" ;;
            *.rar) unrar x "$1" ;;
            *.xz) xz -d "$1" ;;
            *) echo "'$1' Error. Please go away" ;;
        esac
    else
        echo "'$1' is not valid!"
    fi
}
compdef '_files -g "*.{tar.bz2,tar.gz,bz2,gz,tar,tgz,tbz2,zip,Z,7z,rar,xz}"' ext

##
# generate password
gpass() {
    local chars="[:graph:]"
    [[ "$1" == "-n" ]] && chars="[:alnum:]" && shift
    tr </dev/urandom -dc "$chars" | head -c${1:-16}
    echo
}

gpin() {
    tr </dev/urandom -dc '[:digit:]' | head -c${1:-4}
    echo
}

##
# generate and print qrcode on cli
qr() {
    local f="/tmp/qr-$$-$(date +%s).png"

    qrencode "$1" -o "$f" -s 1
    icat "$f"
    rm "$f"
}
