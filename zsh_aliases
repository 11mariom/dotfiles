# -*- sh -*-
##
# variable
_OPTIONS='--color=auto'

##
# alias
alias b='cd ..'
alias calc='autoload -U zcalc && zcalc'
alias e=$EDITOR
alias l='ls $_OPTIONS'
alias s='su'
alias x='exit'
alias zcp='zmv -wC'
alias zln='zmv -wL'
alias zmv='zmv -wM'

##
# default options
alias grep='grep $_OPTIONS'
alias ls='ls $_OPTIONS'
alias tmux='tmux -2'

##
# only for humans in a real terminal: these change semantics (cp/scp are rsync,
# cp -R/-i/-f differ), prompt (-i) or decorate output (bat), which breaks agents/scripts
if (( human )); then
    # using rsync
    alias cp='rsync -pP'
    alias scp='rsync -pP'

    # prompt for overwrite
    alias ln='ln -i'
    alias mv='mv -i'

    # use bat/batcat if available
    if command -v bat >/dev/null 2>&1; then
        alias catcat='/bin/cat'
        alias cat='bat'
    elif command -v batcat >/dev/null 2>&1; then
        alias catcat='/bin/cat'
        alias cat='batcat'
    fi
fi

##
# global alias
alias -g G='| grep'
alias -g H='| head'
alias -g L='| less'
alias -g T='| tail'

##
# dirs
hash -d t='~/tmp'

##
# mac aliases
if [[ $(uname) == 'Darwin' && -x $brew_prefix/sbin/mtr ]]; then
    alias mtr="sudo $brew_prefix/sbin/mtr"
fi

##
# use gopass if available
if command -v gopass >/dev/null 2>&1; then
    alias pass='gopass'
fi

##
# list snapshots
if command -v autorestic >/dev/null 2>&1; then
    alias arestic='autorestic exec -av -- '
fi

##
# Docker-based commands
if command -v podman >/dev/null 2>&1 && ! command -v docker >/dev/null 2>&1; then
    alias docker='podman'
fi

if ! command -v hugo >/dev/null 2>&1; then
    hugo() {
        set -x
        # docker run --rm -u $(id -u):$(id -g) -v "${PWD}/src:/src" -it -p 1313:1313 klakegg/hugo:alpine "$@"
        # user switch not needed in podman, permissions are correct without it
        # setting it breaks lock acquire
        podman run --rm -v "${PWD}/src:/src" -it -p 1313:1313 klakegg/hugo:alpine "$@"
        set +x
    }
fi

if ! command -v helmfile >/dev/null 2>&1; then
    helmfile() {
        set -x
        docker run --rm -v "${HOME}/.kube:/helm/.kube" -v "${HOME}/.config/helm:/helm/.config/helm" -v "${PWD}:/wd" --workdir /wd ghcr.io/helmfile/helmfile:v1.8.2 helmfile "$@"
        set +x
    }
fi

terraform-amd64() {
        set -x
        podman run --rm --platform linux/amd64 -v "${HOME}/.aws:/root/.aws" -v "${PWD}:/wd" --workdir /wd hashicorp/terraform:light "$@"
        set +x
}
